{
  "$id": "turnout-benchmarks.schema.json",
  "title": "Past early-vote curves and final turnout",
  "type": "object",
  "required": ["schemaVersion", "source", "elections"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string" },
    "elections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "id", "name", "electionDate", "final", "history"],
        "additionalProperties": false,
        "properties": {
          "year": { "type": "integer", "minimum": 2000 },
          "id": { "type": "string", "pattern": "^\\d+$" },
          "name": { "type": "string" },
          "electionDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "final": {
            "anyOf": [
              { "type": "null" },
              { "type": "object", "required": ["registeredVoters", "ballotsCast", "turnoutPct"], "additionalProperties": false,
                "properties": {
                  "registeredVoters": { "type": "integer", "minimum": 1 },
                  "ballotsCast": { "type": "integer", "minimum": 0 },
                  "turnoutPct": { "type": "number", "minimum": 0, "maximum": 100 }
                } }
            ]
          },
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["date", "daysBefore", "total", "pct"],
              "additionalProperties": false,
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "daysBefore": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 },
                "pct": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      }
    }
  }
}
